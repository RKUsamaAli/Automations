# =============================================================================
# Server-side settings for the deployment scripts.
#
# setup-server.sh writes this file to /etc/proxy-portal/deploy.env the first
# time it runs (from your answers / command-line flags). Edit it there later.
# Application settings (secrets, limits, ports) live in
# /opt/proxy-portal/shared/.env instead.
# =============================================================================

# --- Where things live ------------------------------------------------------------
APP_USER=portal                         # Linux user that runs the app (no sudo rights)
BASE_DIR=/opt/proxy-portal              # releases/, shared/, current -> releases/<x>

# --- Source code ------------------------------------------------------------------
# SSH URL for a private repo (setup-server.sh creates a read-only deploy key)
# or HTTPS URL for a public one.
REPO_URL=git@github.com:rkusamaali/automations.git
REPO_BRANCH=main                        # what `portal-deploy` deploys when no --ref is given
APP_SUBDIR=web-proxy-portal/app         # path of the Node.js app inside the repo
DEPLOY_SUBDIR=web-proxy-portal/deploy   # path of these scripts inside the repo

# --- Domains & TLS ----------------------------------------------------------------
APP_DOMAIN=portal.example.com           # login / landing / admin
PROXY_DOMAIN=browse.example.com         # proxied websites (must differ from APP_DOMAIN)
SSL_MODE=letsencrypt                    # letsencrypt | custom | none (none = plain http, testing only)
LETSENCRYPT_EMAIL=you@example.com       # expiry notices from Let's Encrypt
SSL_CERT_PATH=                          # SSL_MODE=custom: e.g. Cloudflare origin certificate
SSL_KEY_PATH=

# --- Server -----------------------------------------------------------------------
SSH_PORT=22
NODE_MAJOR=22                           # Node.js LTS line to install
SWAP_SIZE_MB=2048                       # 0 = no swap file
TIMEZONE=UTC

# --- Deploy behaviour -------------------------------------------------------------
KEEP_RELEASES=5                         # old releases kept for rollback
KEEP_DB_BACKUPS=14                      # pre-deploy + daily DB backups kept
HEALTHCHECK_TIMEOUT=90                  # seconds to wait for a new release to become healthy
RUN_TESTS=true                          # run `npm test` before switching (skip: --skip-tests)
AUTO_ROLLBACK=true                      # switch back automatically if the new release is unhealthy
