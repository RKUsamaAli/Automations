# =============================================================================
# nginx site for the Web Proxy Portal (HTTPS)  -  generated by setup-server.sh
# Edit the template in the repo (deploy/templates/nginx-https.conf.tpl), not this file:
# it is overwritten when you run `sudo portal-setup --nginx-only`.
#
#   https://{{APP_DOMAIN}}        -> portal-web   127.0.0.1:{{WEB_PORT}}
#   https://{{PROXY_DOMAIN}}      -> portal-proxy 127.0.0.1:{{PROXY_PORT}}
#   https://{{PROXY_DOMAIN}}:8443 -> portal-proxy 127.0.0.1:{{PROXY_CROSS_PORT}} (cross-origin iframes)
# =============================================================================

# ---- per-IP rate limits (first layer; the app adds per-user limits) ----------
limit_req_zone  $binary_remote_addr zone=pp_login:10m rate=10r/m;
limit_req_zone  $binary_remote_addr zone=pp_api:10m   rate=20r/s;
limit_req_zone  $binary_remote_addr zone=pp_proxy:20m rate=60r/s;
limit_conn_zone $binary_remote_addr zone=pp_conn:10m;
limit_req_status  429;
limit_conn_status 429;

# Access log with timing and the request id (also sent to the app as X-Request-Id,
# so an error report's request_id can be found here:  grep rid=<id> /var/log/nginx/proxy-portal-*.log)
log_format pp_main '$remote_addr [$time_local] "$request" $status $body_bytes_sent '
                   'rt=$request_time host=$host rid=$request_id "$http_user_agent"';

# WebSocket upgrade when asked for; otherwise an empty Connection header so the
# connection to Node.js is kept alive and reused (upstream keepalive below).
map $http_upgrade $pp_connection_upgrade {
    default upgrade;
    ''      '';
}

# ---- Node.js processes, with a pool of reused (keep-alive) connections -------
upstream pp_web          { server 127.0.0.1:{{WEB_PORT}};         keepalive 32; }
upstream pp_proxy_main   { server 127.0.0.1:{{PROXY_PORT}};       keepalive 64; }
upstream pp_proxy_cross  { server 127.0.0.1:{{PROXY_CROSS_PORT}}; keepalive 16; }

# If you put Cloudflare (orange cloud) in front, uncomment so logs and rate
# limits see the real visitor IP (full list: https://www.cloudflare.com/ips/):
# set_real_ip_from 173.245.48.0/20;  ...  real_ip_header CF-Connecting-IP;

# ---- HTTP: ACME challenges + redirect to HTTPS --------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name {{APP_DOMAIN}} {{PROXY_DOMAIN}};

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }
    location / {
        # 308 (not 301): keeps the method and body, so a form/API POST that
        # arrives over http (old tab, typed http://) still works after the
        # redirect instead of turning into a GET and failing.
        return 308 https://$host$request_uri;
    }
}

# ---- Portal: login, landing page, admin -----------------------------------------
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{APP_DOMAIN}};

    ssl_certificate     {{SSL_CERT}};
    ssl_certificate_key {{SSL_KEY}};
    include /etc/nginx/snippets/proxy-portal-ssl.conf;
    include /etc/nginx/snippets/proxy-portal-gzip.conf;

    add_header Strict-Transport-Security "max-age=31536000" always;
    client_max_body_size 2m;
    access_log /var/log/nginx/proxy-portal-app.access.log pp_main;
    error_log  /var/log/nginx/proxy-portal-app.error.log warn;

    location = /api/auth/login {
        limit_req zone=pp_login burst=5 nodelay;
        include /etc/nginx/snippets/proxy-portal-upstream.conf;
        proxy_pass http://pp_web;
    }
    location / {
        limit_req zone=pp_api burst=60 nodelay;
        include /etc/nginx/snippets/proxy-portal-upstream.conf;
        proxy_pass http://pp_web;
    }
}

# ---- Proxy engine: main origin ----------------------------------------------------
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{PROXY_DOMAIN}};

    ssl_certificate     {{SSL_CERT}};
    ssl_certificate_key {{SSL_KEY}};
    include /etc/nginx/snippets/proxy-portal-ssl.conf;
    include /etc/nginx/snippets/proxy-portal-gzip.conf;

    client_max_body_size 100m;       # uploads on proxied sites
    access_log /var/log/nginx/proxy-portal-proxy.access.log pp_main;
    error_log  /var/log/nginx/proxy-portal-proxy.error.log warn;

    location / {
        limit_req  zone=pp_proxy burst=400 nodelay;
        limit_conn pp_conn 200;
        include /etc/nginx/snippets/proxy-portal-upstream.conf;
        proxy_pass http://pp_proxy_main;
    }
}

# ---- Proxy engine: cross-domain origin (port 8443) -----------------------------------
server {
    listen 8443 ssl http2;
    listen [::]:8443 ssl http2;
    server_name {{PROXY_DOMAIN}};

    ssl_certificate     {{SSL_CERT}};
    ssl_certificate_key {{SSL_KEY}};
    include /etc/nginx/snippets/proxy-portal-ssl.conf;
    include /etc/nginx/snippets/proxy-portal-gzip.conf;

    client_max_body_size 100m;
    access_log /var/log/nginx/proxy-portal-proxy.access.log pp_main;
    error_log  /var/log/nginx/proxy-portal-proxy.error.log warn;

    location / {
        limit_req  zone=pp_proxy burst=400 nodelay;
        limit_conn pp_conn 200;
        include /etc/nginx/snippets/proxy-portal-upstream.conf;
        proxy_pass http://pp_proxy_cross;
    }
}
