# =============================================================================
# Web Proxy Portal - application configuration
#
# On the server this file lives at /opt/proxy-portal/shared/.env and is
# created by deploy/setup-server.sh (secrets generated automatically).
# Every release links to it, so deploys and rollbacks never change it.
#
# After editing on the server:   sudo portal-restart
# =============================================================================

NODE_ENV=production
LOG_LEVEL=info                      # debug | info | warn | error
LOG_FORMAT=json                     # console format: json | text (files are always JSON)
# System logs are also written to files: <LOG_DIR>/YYYY-MM-DD.<process>.log (JSON lines, UTC days)
# LOG_DIR=/opt/proxy-portal/shared/logs/app   # default: <DATA_DIR>/../logs/app
LOG_FILE_RETENTION_DAYS=14          # delete system log files older than this

# --- Public hostnames (both must point at this server in DNS) ----------------
# Portal: login page, landing page, admin panel
APP_DOMAIN=portal.example.com
# Proxy engine: where proxied websites are shown. MUST differ from APP_DOMAIN.
PROXY_DOMAIN=browse.example.com
PUBLIC_PROTOCOL=https
PUBLIC_PORT=443
# Second public port used by the engine for cross-origin iframes (open in firewall)
PUBLIC_CROSS_DOMAIN_PORT=8443

# --- Secrets ------------------------------------------------------------------
# Long random string (64+ chars). Changing it logs everyone out.
APP_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters
# Used by Rammerhead to version its rewritten-JS cache. Keep it stable.
DEPLOY_SECRET=change-me-too

# --- Internal ports (bound to 127.0.0.1, nginx proxies to them) --------------
WEB_HOST=127.0.0.1
WEB_PORT=3000
WEB_INSTANCES=1                     # portal processes (2 = zero-downtime reloads)
PROXY_HOST=127.0.0.1
PROXY_PORT=8080
PROXY_CROSS_DOMAIN_PORT=8081

# --- Proxy engine tuning --------------------------------------------------------
# 0 = single process (1-2 vCPU servers). N = Rammerhead cluster with N workers.
PROXY_WORKERS=0
PROXY_WORKER_MAX_MEMORY_MB=0        # per-worker memory guard when PROXY_WORKERS>0 (0 = off)
PROXY_JS_CACHE_TYPE=memory          # memory | disk
PROXY_JS_CACHE_MB=50                # rewritten-JS cache size
PROXY_DISABLE_HTTP2=false

# --- PM2 memory guards (restart process when exceeded) ---------------------------
#   512 MB VPS : WEB_MAX_MEMORY=150M PROXY_MAX_MEMORY=350M PROXY_NODE_ARGS=--max-old-space-size=384
#   1 GB VPS   : WEB_MAX_MEMORY=200M PROXY_MAX_MEMORY=600M PROXY_NODE_ARGS=--max-old-space-size=640
#   4 GB VPS   : WEB_MAX_MEMORY=300M PROXY_MAX_MEMORY=2500M PROXY_NODE_ARGS=--max-old-space-size=2560
WEB_MAX_MEMORY=200M
PROXY_MAX_MEMORY=600M
PROXY_NODE_ARGS=--max-old-space-size=640

# --- Browsing sessions --------------------------------------------------------
SESSION_IDLE_TIMEOUT_MIN=60         # purge a session after this much inactivity
SESSION_MAX_LIFETIME_HOURS=24       # hard maximum age of a session (0 = none)
SESSION_CLEANUP_INTERVAL_MIN=15     # how often the purge runs
# Sign-in tokens (JWT). The identity token lasts this long; after that the user
# re-enters the password (the current page stays). Access tokens are renewed
# silently from the identity token.
IDENTITY_TOKEN_TTL_HOURS=24
ACCESS_TOKEN_TTL_MINUTES=5

# --- Upstream proxy health checks -------------------------------------------------
HEALTHCHECK_ENABLED=true
HEALTHCHECK_URL=https://www.gstatic.com/generate_204
HEALTHCHECK_INTERVAL_MIN=5
HEALTHCHECK_TIMEOUT_MS=10000
HEALTHCHECK_SLOW_MS=5000            # slower than this = "slow" (used only as last resort)
HEALTHCHECK_FAILURES_BEFORE_DEAD=3
HEALTHCHECK_CONCURRENCY=10

# --- Storage ------------------------------------------------------------------
# Relative paths are resolved from the app directory. On the server these point
# into /opt/proxy-portal/shared so data survives deploys.
DATA_DIR=./data
LOG_RETENTION_DAYS=30               # activity log
API_RATE_LIMIT_RPM=600              # portal API calls per minute per signed-in user (writes count 3x)
API_RATE_LIMIT_ANON_RPM=120         # portal API calls per minute per IP when signed out
SIGNUP_LIMIT_PER_HOUR=5             # sign-ups per hour per IP (spam protection)
# Top bar on proxied pages: each proxy's exit IP, location and time zone (for the
# local-time clock) are looked up THROUGH the proxy (hourly, and right after a
# switch); sessions without a proxy show the server's own (looked up directly).
# Must answer JSON like https://ipwho.is/
# ({"ip","country","country_code","city","timezone":{"id"},"connection":{"isp"}}) or {"ip"}.
# EXIT_IP_CHECK_URL=https://ipwho.is/
# TOOLBAR_SHADOW=open               # test servers only (lets browser tests inspect the top bar)
# Live browser (PM2 app portal-live): a real Chromium per user on the server,
# shown in the page. Each one needs ~250-400 MB RAM while open.
# LIVE_PORT=3004                    # 127.0.0.1 only (portal-web forwards /live/ws to it)
# LIVE_MAX_BROWSERS=2               # users with an open browser at the same time
# LIVE_IDLE_MIN=15                  # close a browser nobody looked at for this long (logins stay)
# LIVE_QUALITY=70                   # screen JPEG quality (lower = less data)
# LIVE_HEADED=auto                  # auto = visible Chrome on a virtual screen (Xvfb) when installed
# Search worker (PM2 app portal-search): Google results read by a headless Chromium.
# SEARCH_PORT=3003                  # 127.0.0.1 only
# SEARCH_CONCURRENCY=2              # searches at the same time (each ~100 MB RAM)
# SEARCH_TIMEOUT_MS=20000
# SEARCH_MAX_MEMORY=600M            # PM2 restarts the worker above this
# PLAYWRIGHT_BROWSERS_PATH=/opt/proxy-portal/shared/ms-playwright   # where deploy installs Chromium
# GOOGLE_SEARCH_URL=https://www.google.com/search?q={q}&num=10&hl={hl}   # test servers point this at a fake
ERROR_RETENTION_DAYS=30             # error reports (docs/LOGGING.md)
REQUEST_LOG_LEVEL=pages             # pages = proxied pages + portal actions + failures | all = also every image/script | off = failures only
REQUEST_LOG_RETENTION_DAYS=14       # request log (Admin -> Requests)
METRICS_RETENTION_DAYS=30           # server health samples (Admin -> Server)
# METRICS_INTERVAL_MS=60000         # how often each process samples its health
TRUST_PROXY=true                    # trust X-Real-IP from nginx on 127.0.0.1
# RAMMERHEAD_DIR=./vendor/rammerhead

# --- Automated tests only ---------------------------------------------------------
# Lets USER-added proxies point at private addresses (127.0.0.1 ...). Needed only
# when running the Playwright suite against a test server. NEVER on production.
# ALLOW_PRIVATE_UPSTREAMS=false
